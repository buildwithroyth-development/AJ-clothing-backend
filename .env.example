# AJ Clothing Backend — Environment Variables
# Copy this file to .env for local development and fill in your values.

# Django
DEBUG=True
SECRET_KEY=any-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra frontend origins allowed by CORS (comma separated). *.vercel.app is already allowed.
CORS_ALLOWED_ORIGINS=

# Firebase Realtime Database (Admin SDK)
FIREBASE_DATABASE_URL=https://aj-clothing-e8477-default-rtdb.firebaseio.com
# Paste the ENTIRE service-account JSON on one line (Firebase console → Project settings → Service accounts → Generate new private key).
# Never commit this value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or, locally, point to the downloaded key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json
