# AJ Clothing Backend — Environment Variables
# Copy this file to .env for local development and fill in your values.

# Django
DEBUG=True
SECRET_KEY=any-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra frontend origins allowed by CORS (comma separated). *.vercel.app is already allowed.
CORS_ALLOWED_ORIGINS=

# Firebase Realtime Database (Admin SDK)
FIREBASE_DATABASE_URL=https://aj-clothing-e8477-default-rtdb.firebaseio.com
# Paste the ENTIRE service-account JSON on one line (Firebase console → Project settings → Service accounts → Generate new private key).
# Never commit this value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or, locally, point to the downloaded key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json

# Who may use the app after creating an account and verifying their e-mail.
# By default everyone with a verified e-mail gets in. Set to False to require approval:
# then only users listed under staff/<uid> = true in the database (or in STAFF_EMAILS) can get in.
AUTO_APPROVE_VERIFIED_USERS=True
# Used only when AUTO_APPROVE_VERIFIED_USERS=False: comma-separated e-mails approved once verified.
STAFF_EMAILS=
 
# Email Billing (SMTP / Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
# For Gmail, generate a 16-character App Password at: myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_SENDER_NAME=AJ Clothing

# Store Profile Details (Used in PDF Receipts and Email Headers; optional, can also be configured via Settings in DB)
STORE_NAME=AJ Clothing Store
STORE_TAGLINE=
STORE_ADDRESS=Commercial Street, Bangalore
STORE_PHONE=+91 98765 43210
STORE_EMAIL=contact@ajclothing.com
STORE_GSTIN=
STORE_NOTE=Returns within 7 days with tag intact.
